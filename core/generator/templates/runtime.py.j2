# semantic conventions so the traces stay readable by standard tooling.
from __future__ import annotations

import json
import os
import time
from typing import Any


class Tracer:
    def __init__(self, path: str | None = None) -> None:
        self.path = path or os.environ.get("ARCHITECT_TRACE_PATH")
        self._fh = open(self.path, "a", encoding="utf-8") if self.path else None

    def emit(self, event: dict[str, Any]) -> None:
        event.setdefault("ts", time.time())
        if self._fh:
            self._fh.write(json.dumps(event, default=str) + "\n")
            self._fh.flush()

    def close(self) -> None:
        if self._fh:
            self._fh.close()


class AgentBase:
    NAME = "agent"
    TOOLS: list[str] = []
    MODEL: dict[str, Any] = {}

    def __init__(self, tracer: Tracer | None = None) -> None:
        self.tracer = tracer or Tracer()

    def record_llm(self, request: dict[str, Any], response: dict[str, Any]) -> None:
        """Call this around every model call. Full request AND response are kept so a
        run can be replayed later (replay needs content, not just metadata)."""
        self.tracer.emit({
            "event": "gen_ai.call",
            "agent": self.NAME,
            "gen_ai.request.model": request.get("model", self.MODEL.get("model")),
            "gen_ai.response.model": response.get("model"),
            "gen_ai.usage.input_tokens": (response.get("usage") or {}).get("input_tokens"),
            "gen_ai.usage.output_tokens": (response.get("usage") or {}).get("output_tokens"),
            "request": request,
            "response": response,
        })

    def __call__(self, task: Any) -> Any:
        t0 = time.perf_counter()
        self.tracer.emit({"event": "agent.start", "agent": self.NAME, "input": task})
        try:
            out = self.run(task)
        except Exception as exc:
            self.tracer.emit({"event": "agent.error", "agent": self.NAME,
                              "error": f"{type(exc).__name__}: {exc}",
                              "duration_ms": round((time.perf_counter() - t0) * 1000, 2)})
            raise
        self.tracer.emit({"event": "agent.end", "agent": self.NAME, "output": out,
                          "duration_ms": round((time.perf_counter() - t0) * 1000, 2)})
        return out

    def run(self, task: Any) -> Any:  # pragma: no cover
        raise NotImplementedError
